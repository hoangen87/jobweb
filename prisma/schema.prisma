generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                    String        @id @default(cuid())
  title                 String
  department            String
  location              String
  type                  String
  level                 String?
  quantity              Int           @default(1)
  salaryMin             Int?
  salaryMax             Int?
  description           String
  requirements          String
  benefits              String?
  translations          Json?
  deadline              DateTime?
  status                String        @default("OPEN")
  reqEducationMin       String?
  reqExperienceYearsMin Int?
  reqAgeMin             Int?
  reqAgeMax             Int?
  reqField              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  applications          Application[]
}

model Application {
  id                 String                  @id @default(cuid())
  jobId              String
  job                Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fullName           String
  email              String
  phone               String
  dateOfBirth        DateTime?
  education          String?
  experienceYears    Int?
  fieldOfExpertise   String?
  coverLetter        String?
  cvFileName         String
  cvFilePath         String
  status             String                  @default("NEW")
  aiScore            Int?
  aiSummary          String?
  aiStatus           String?
  aiAnalyzedAt       DateTime?
  aiJobDescriptionId String?
  aiJobDescription   JobDescription?         @relation("ApplicationEvaluationJd", fields: [aiJobDescriptionId], references: [id], onDelete: SetNull)
  evaluations        ApplicationEvaluation[]
  createdAt          DateTime                @default(now())
}

model JobDescription {
  id          String                  @id @default(cuid())
  title       String
  department  String
  version     Int                     @default(1)
  fileName    String
  filePath    String
  content     String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  evaluations Application[]           @relation("ApplicationEvaluationJd")
  results     ApplicationEvaluation[]
}

model ApplicationEvaluation {
  id                 String         @id @default(cuid())
  applicationId      String
  application        Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobDescriptionId   String
  jobDescription     JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  jdVersion          Int
  score              Int
  matchingExperience String
  matchingSkills     String
  gaps               String
  aiComment          String
  rank               Int?
  provider           String         @default("gemini")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([applicationId, jobDescriptionId])
  @@index([jobDescriptionId, score])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String?
  passwordHash String
  role         String   @default("SUPER_ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model SystemSetting {
  key            String   @id
  encryptedValue String
  updatedAt      DateTime @updatedAt
}
